# Copy to .env (never commit .env)
PORT=8087
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
# Generate with: node generate.js   (required for any sign-in: user accounts and admins)
SECRET_KEY=
# Optional built-in admin that doesn't live in the database. Other accounts can be
# made admins from the dashboard, or with: node generate.js promote <email>
ADMIN_EMAIL=admin@example.com
# Generate with: node generate.js hash <password>   (wrap the value in single quotes)
ADMIN_PASSWORD_HASH=
# Comma-separated frontend origins allowed by CORS, e.g. https://nourishnet.example.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
